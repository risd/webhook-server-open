#!/usr/bin/env node

const async = require( 'async' )
const grunt = require( 'grunt' )
const webhookTasks = require( '../Gruntfile.js' )
const resetKeys = require( '../libs/reset-keys.js' )

webhookTasks( grunt )

resetKeys({
  config: grunt.config,
}).then(() => {
  process.exit()
})
.catch((error) => {
  console.error(error)
  process.exit(1)
})
